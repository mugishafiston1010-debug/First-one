# --- Database (PostgreSQL). Online: Supabase "Transaction pooler" URL here ---
DATABASE_URL="postgresql://app:app@localhost:5432/remit"
# Direct connection for migrations. Online: Supabase "Session pooler" or direct URL.
DIRECT_URL="postgresql://app:app@localhost:5432/remit"

# --- Security ---
SESSION_SECRET="replace-with-64-random-characters"
# Needed once to create the first admin at /setup. Remove after setup.
SETUP_TOKEN="replace-with-a-long-random-code"

# --- Brand and support contacts ---
NEXT_PUBLIC_BRAND="Inzira"
NEXT_PUBLIC_WHATSAPP="79990000000"
NEXT_PUBLIC_TELEGRAM="inzira_support"
# Public address of the site, e.g. https://inzira.vercel.app
APP_URL="http://localhost:3000"

# --- File storage. With S3_* empty: files go to the database on Vercel (or set FILE_STORAGE="db"),
# and to the local disk on your computer ---
UPLOAD_DIR="./uploads"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- AI receipt check (optional). Key from console.anthropic.com ---
ANTHROPIC_API_KEY=""

# --- Telegram notifications (optional). Token from @BotFather ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET="replace-with-random-letters-and-digits"
# Chat (or group) where your team gets new orders and receipts
TELEGRAM_ADMIN_CHAT_ID=""

# --- WhatsApp Cloud API (optional, needs an approved Meta business account) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="order_update"
WHATSAPP_TEMPLATE_LANG="en"
