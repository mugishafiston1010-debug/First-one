# Optional. Without it Clarity runs fully on-device (demo mode): documents never
# leave the browser. With it, users may choose - per document, after an explicit
# confirmation - to have Claude analyse a document. The key is only ever read on
# the server (src/lib/ai/server) and is never sent to the browser.
ANTHROPIC_API_KEY=

# Optional. Model used for cloud analysis and questions.
CLARITY_MODEL=claude-opus-5-5
