# --- Database (PostgreSQL 14+) ---
DATABASE_URL="postgresql://app:app@localhost:5432/afrostart"
# Direct (non-pooled) connection for migrations. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://app:app@localhost:5432/afrostart"

# --- Security ---
# At least 32 random characters. Generate: openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Salt used to hash IP addresses for rate limiting / spam control (never stored in plain form)
IP_HASH_SALT="replace-with-random-characters"

# --- Public site address (used for sitemap, canonical URLs, Open Graph) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
